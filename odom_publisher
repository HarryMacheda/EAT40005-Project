import rclpy
from rclpy.node import Node
from nav_msgs.msg import Odometry
from geometry_msgs.msg import Point, Quaternion
from rclpy.qos import QoSProfile
import tf_transformations
import csv
import math
import os

class CsvOdomPublisher(Node):
    def __init__(self):
        super().__init__('csv_odom_publisher')

        # Declare parameter and get CSV path
        self.declare_parameter('csv_path', '')
        csv_path = self.get_parameter('csv_path').get_parameter_value().string_value

        if not csv_path or not os.path.exists(csv_path):
            self.get_logger().error(f'Invalid CSV path: {csv_path}')
            return

        self.data = self.load_csv_data(csv_path)
        self.index = 0

        self.publisher = self.create_publisher(Odometry, '/odom', QoSProfile(depth=10))
        self.timer = self.create_timer(1.0, self.publish_next)  # 1 Hz = one row per second

        self.get_logger().info(f'Loaded {len(self.data)} odometry rows from CSV.')

    def load_csv_data(self, path):
        with open(path, 'r') as f:
            reader = csv.DictReader(f)
            return list(reader)

    def publish_next(self):
        if not self.data:
            self.get_logger().warn('CSV data is empty. Nothing to publish.')
            return

        if self.index >= len(self.data):
            self.get_logger().info('Reached end of CSV, looping back to start.')
            self.index = 0  # loop

        row = self.data[self.index]
        try:
            x = float(row['X'])
            y = float(row['Y'])
            yaw_deg = float(row['Yaw'])
            yaw_rad = math.radians(yaw_deg)

            # Convert yaw to quaternion
            q = tf_transformations.quaternion_from_euler(0, 0, yaw_rad)

            msg = Odometry()
            msg.header.stamp = self.get_clock().now().to_msg()
            msg.header.frame_id = 'odom'

            msg.pose.pose.position = Point(x=x, y=y, z=0.0)
            msg.pose.pose.orientation = Quaternion(x=q[0], y=q[1], z=q[2], w=q[3])

            self.publisher.publish(msg)
            self.get_logger().info(f'Published odom[{self.index}]: x={x:.2f}, y={y:.2f}, yaw={yaw_deg:.2f}')
        except Exception as e:
            self.get_logger().error(f'Failed to publish row {self.index}: {e}')

        self.index += 1


def main(args=None):
    rclpy.init(args=args)
    node = CsvOdomPublisher()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()

